{
  "name": "ai-diff-follow",
  "displayName": "AI Diff · 跟写工作台",
  "description": "在 VS Code 中审查、学习 Git 仓库，并将提交范围合为一个目标，用原生虚影一比一跟写。",
  "version": "0.1.25",
  "publisher": "jtsgxh",
  "license": "ISC",
  "repository": { "type": "git", "url": "https://github.com/Jtsgxh/AI-Diff-tool.git" },
  "engines": { "vscode": "^1.100.0" },
  "categories": ["Other", "Education"],
  "main": "./out/extension.cjs",
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": { "supported": false, "description": "需要读取本地 Git 仓库、运行 Git 并创建独立练习目录。" }
  },
  "contributes": {
    "commands": [
      { "command": "aiDiff.open", "title": "打开审查与学习工作台", "category": "AI Diff", "icon": "$(open-preview)" },
      { "command": "aiDiff.follow.create", "title": "创建跟写练习", "category": "AI Diff", "icon": "$(add)" },
      { "command": "aiDiff.follow.check", "title": "保存并检查内容", "category": "AI Diff", "icon": "$(check)" },
      { "command": "aiDiff.follow.next", "title": "校验并进入下一步", "category": "AI Diff", "icon": "$(arrow-right)" },
      { "command": "aiDiff.follow.finish", "title": "校验并完成练习", "category": "AI Diff", "icon": "$(pass)" },
      { "command": "aiDiff.follow.combine", "title": "将当前练习合并为一个目标", "category": "AI Diff", "icon": "$(git-merge)" },
      { "command": "aiDiff.follow.open", "title": "打开虚影跟写", "category": "AI Diff" },
      { "command": "aiDiff.follow.compare", "title": "查看目标对照", "category": "AI Diff" },
      { "command": "aiDiff.follow.locate", "title": "定位下一处跟写", "category": "AI Diff", "icon": "$(go-to-file)" },
      { "command": "aiDiff.follow.stable", "title": "启用稳定跟写窗口", "category": "AI Diff", "icon": "$(window)" },
      { "command": "aiDiff.follow.delete", "title": "删除本步要求移除的文件", "category": "AI Diff" },
      { "command": "aiDiff.follow.sync", "title": "同步本步二进制资源", "category": "AI Diff" },
      { "command": "aiDiff.symbols", "title": "搜索工作区代码符号", "category": "AI Diff", "icon": "$(symbol-method)" }
    ],
    "keybindings": [
      { "key": "enter", "command": "runCommands", "args": { "commands": ["hideSuggestWidget", "editor.action.inlineSuggest.hide", { "command": "default:type", "args": { "text": "\n" } }] }, "when": "editorTextFocus && aiDiff.followEditing && !editorReadonly" },
      { "key": "tab", "command": "tab", "when": "editorTextFocus && aiDiff.followEditing && !editorReadonly && !editorTabMovesFocus && !suggestWidgetVisible && !inSnippetMode && !inlineSuggestionVisible" },
      { "key": "tab", "command": "editor.action.inlineSuggest.commit", "when": "editorTextFocus && aiDiff.followEditing && !editorReadonly && !editorTabMovesFocus && !suggestWidgetVisible && !inSnippetMode && inlineSuggestionVisible" },
      { "key": "shift+tab", "command": "outdent", "when": "editorTextFocus && aiDiff.followEditing && !editorReadonly && !editorTabMovesFocus && !inSnippetMode" },
      { "key": "tab", "command": "jumpToNextSnippetPlaceholder", "when": "editorTextFocus && aiDiff.followEditing && !editorReadonly && !editorTabMovesFocus && !suggestWidgetVisible && inSnippetMode && hasNextTabstop" },
      { "key": "shift+tab", "command": "jumpToPrevSnippetPlaceholder", "when": "editorTextFocus && aiDiff.followEditing && !editorReadonly && !editorTabMovesFocus && inSnippetMode && hasPrevTabstop" },
      { "key": "ctrl+right", "mac": "alt+right", "command": "editor.action.inlineSuggest.acceptNextWord", "when": "editorTextFocus && aiDiff.followEditing && inlineSuggestionVisible && !editorReadonly" }
    ],
    "views": { "explorer": [{ "id": "aiDiff.follow", "name": "AI Diff 跟写" }] },
    "viewsWelcome": [{ "view": "aiDiff.follow", "contents": "从已有 Git 提交开始，在原生编辑器中一比一跟写。\n[创建练习](command:aiDiff.follow.create)\n[打开审查与学习工作台](command:aiDiff.open)" }],
    "menus": {
      "view/title": [
        { "command": "aiDiff.follow.create", "when": "view == aiDiff.follow", "group": "navigation@1" },
        { "command": "aiDiff.follow.check", "when": "view == aiDiff.follow", "group": "navigation@2" },
        { "command": "aiDiff.follow.stable", "when": "view == aiDiff.follow && aiDiff.followMode", "group": "navigation@2.5" },
        { "command": "aiDiff.follow.next", "when": "view == aiDiff.follow && aiDiff.followMode == commits", "group": "navigation@3" },
        { "command": "aiDiff.follow.finish", "when": "view == aiDiff.follow && aiDiff.followMode == combined", "group": "navigation@3" },
        { "command": "aiDiff.follow.combine", "when": "view == aiDiff.follow && aiDiff.followMode == commits", "group": "tools" },
        { "command": "aiDiff.open", "when": "view == aiDiff.follow", "group": "navigation@4" },
        { "command": "aiDiff.symbols", "when": "view == aiDiff.follow", "group": "tools" }
      ],
      "commandPalette": [
        { "command": "aiDiff.follow.next", "when": "aiDiff.followMode == commits" },
        { "command": "aiDiff.follow.finish", "when": "aiDiff.followMode == combined" },
        { "command": "aiDiff.follow.combine", "when": "aiDiff.followMode == commits" }
      ],
      "view/item/context": [
        { "command": "aiDiff.follow.compare", "when": "view == aiDiff.follow", "group": "follow" },
        { "command": "aiDiff.follow.delete", "when": "view == aiDiff.follow && viewItem == followDeleted", "group": "follow" },
        { "command": "aiDiff.follow.sync", "when": "view == aiDiff.follow && viewItem == followFile", "group": "follow" }
      ]
    }
  },
  "scripts": { "vscode:prepublish": "npm --prefix .. run build:vscode" },
  "devDependencies": { "@types/vscode": "1.100.0" }
}
